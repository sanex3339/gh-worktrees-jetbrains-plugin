<idea-plugin>
    <!-- The id is permanent once published to JetBrains Marketplace. -->
    <id>com.github.sanex3339.worktreetabs</id>
    <name>Worktree Tabs</name>
    <vendor email="sanex3339@gmail.com" url="https://github.com/sanex3339">sanex3339</vendor>
    <description><![CDATA[
    <p>A tab for every <b>git worktree</b> of your project, and one click switches the whole IDE to it,
    <b>in the same window</b>: code, project tree, search and Git follow, without reopening the project.
    Each worktree keeps its own editor tabs, bookmarks, breakpoints and changelists; run configurations and new
    terminals follow the switch. Terminals and processes that are already running keep running.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <depends optional="true" config-file="worktreetabs-javascript.xml">JavaScript</depends>
    <depends optional="true" config-file="worktreetabs-terminal.xml">org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="worktreetabs-xdebugger.xml">com.intellij.modules.xdebugger</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="com.github.sanex3339.worktreetabs.switchStep"
                        interface="com.github.sanex3339.worktreetabs.switching.SwitchStep" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <ideRootPaneNorth implementation="com.github.sanex3339.worktreetabs.ui.WorktreeTabsNorthExtension"/>
        <postStartupActivity implementation="com.github.sanex3339.worktreetabs.WorktreeTabsStartup"/>
        <notificationGroup id="Worktree Tabs" displayType="BALLOON"/>
    </extensions>

    <extensions defaultExtensionNs="com.github.sanex3339.worktreetabs">
        <switchStep implementation="com.github.sanex3339.worktreetabs.switching.steps.EditorsStep"/>
        <switchStep implementation="com.github.sanex3339.worktreetabs.switching.steps.BookmarksStep"/>
        <switchStep implementation="com.github.sanex3339.worktreetabs.switching.steps.ChangelistsStep"/>
        <switchStep implementation="com.github.sanex3339.worktreetabs.switching.steps.RunConfigurationsStep"/>
    </extensions>

    <actions>
        <action id="WorktreeTabs.Switch" class="com.github.sanex3339.worktreetabs.actions.SwitchWorktreeAction"
                text="Switch Worktree…" description="Switch the project to another worktree of its repository">
            <add-to-group group-id="Git.MainMenu" anchor="last"/>
        </action>
        <action id="WorktreeTabs.MultipleRows" class="com.github.sanex3339.worktreetabs.actions.ToggleMultipleRowsAction"
                text="Show Worktree Tabs in Multiple Rows"
                description="Wrap the worktree tabs into several rows instead of one scrollable row"/>
        <action id="WorktreeTabs.New" class="com.github.sanex3339.worktreetabs.actions.NewWorktreeAction"
                text="Create Worktree…" description="Create a git worktree and switch this window to it" icon="AllIcons.General.Add">
            <add-to-group group-id="Git.MainMenu" anchor="last"/>
        </action>
        <action id="WorktreeTabs.SwitchTo" class="com.github.sanex3339.worktreetabs.actions.SwitchToWorktreeAction"
                text="Switch to This Worktree"/>
        <action id="WorktreeTabs.Lock" class="com.github.sanex3339.worktreetabs.actions.LockWorktreeAction"
                text="Lock…" description="Keep the worktree from being pruned, moved or removed (git worktree lock)"/>
        <action id="WorktreeTabs.Unlock" class="com.github.sanex3339.worktreetabs.actions.UnlockWorktreeAction"
                text="Unlock" description="Allow pruning, moving and removing the worktree again (git worktree unlock)"/>
        <action id="WorktreeTabs.Remove" class="com.github.sanex3339.worktreetabs.actions.RemoveWorktreeAction"
                text="Remove Worktree…" description="Delete the worktree's folder (git worktree remove); its branch stays"/>
        <group id="WorktreeTabs.StripPopup">
            <reference ref="WorktreeTabs.New"/>
            <reference ref="WorktreeTabs.Switch"/>
            <separator/>
            <reference ref="WorktreeTabs.MultipleRows"/>
        </group>
        <group id="WorktreeTabs.TabPopup">
            <reference ref="WorktreeTabs.SwitchTo"/>
            <separator/>
            <reference ref="WorktreeTabs.Lock"/>
            <reference ref="WorktreeTabs.Unlock"/>
            <reference ref="WorktreeTabs.Remove"/>
            <separator/>
            <reference ref="WorktreeTabs.New"/>
            <reference ref="WorktreeTabs.MultipleRows"/>
        </group>
    </actions>
</idea-plugin>
